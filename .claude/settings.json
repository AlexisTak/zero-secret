{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make test-crypto)",
      "Bash(make generate)",
      "Bash(make audit)",
      "Bash(make sbom)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Edit(apps/**)",
      "Edit(crates/**)",
      "Edit(pkg/**)",
      "Edit(contracts/**)",
      "Edit(policies/**)",
      "Edit(tests/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(cargo add:*)",
      "Bash(go get:*)",
      "Bash(npm install:*)",
      "Bash(tofu:*)",
      "Bash(ansible-playbook:*)",
      "Bash(psql:*)",
      "Bash(bao:*)",
      "Edit(crates/zs-crypto/**)",
      "Edit(deploy/**)",
      "Edit(security/**)",
      "Edit(Makefile)",
      "Edit(.github/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/openbao/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/*_generated.rs)",
      "Edit(**/*.pb.go)",
      "Edit(**/zz_generated_*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git rebase:*)",
      "Bash(bao write auth/:*)",
      "Bash(kubectl:*)",
      "Bash(docker:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/no-direct-crypto.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/no-secrets.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/format-changed.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Branche: $(git branch --show-current) | ADR ouverts: $(ls docs/adr/*.md 2>/dev/null | wc -l) | Rappel: contrat -> generate -> tests -> impl -> audit\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "ZS_ENV": "dev",
    "ZS_HSM_MODULE": "/usr/lib/softhsm/libsofthsm2.so"
  },
  "includeCoAuthoredBy": false
}
